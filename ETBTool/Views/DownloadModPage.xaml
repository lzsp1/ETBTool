<Page x:Class="ETBTool.Views.DownloadModPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:u="clr-namespace:ETBTool.Utils"
      Background="Transparent" FocusVisualStyle="{x:Null}">
	<Page.Resources>
		<u:BoolToVisibilityConverter x:Key="BoolToVis"/>
		<u:NullToVisibilityConverter x:Key="NullToVis"/>
		<u:CountToVisibilityConverter x:Key="CountToVis"/>
		<u:CategoryToDisplayConverter x:Key="CatDisplay"/>
		<u:DownloadsDisplayConverter x:Key="DlDisplay"/>

		<Style x:Key="ModInput" TargetType="TextBox">
			<Setter Property="Background" Value="{DynamicResource SurfaceColor}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="ModPwd" TargetType="PasswordBox">
			<Setter Property="Background" Value="{DynamicResource SurfaceColor}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="PasswordBox">
						<Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DlProgress" TargetType="ProgressBar">
			<Setter Property="Height" Value="6"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ProgressBar">
						<Border Background="{DynamicResource SurfaceColor}" CornerRadius="3" ClipToBounds="True">
							<Grid>
								<Border x:Name="PART_Track"/>
								<Border x:Name="PART_Indicator" Background="{DynamicResource AccentColor}" CornerRadius="3" HorizontalAlignment="Left"/>
							</Grid>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<DataTemplate x:Key="ModCardTpl">
			<Border Style="{StaticResource Card}" Padding="16" Width="240" Margin="4" Cursor="Hand">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenDetailCmd, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding Id}"/>
				</Border.InputBindings>
				<StackPanel>
					<DockPanel>
						<Border Background="{DynamicResource AccentColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
							<TextBlock Text="{Binding Category, Converter={StaticResource CatDisplay}}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
						</Border>
						<TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0">
							<Run Text="v"/>
							<Run Text="{Binding Version, Mode=OneWay}"/>
						</TextBlock>
					</DockPanel>
					<TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,4" TextTrimming="CharacterEllipsis"/>
					<TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap"/>
					<DockPanel Margin="0,8,0,0">
						<TextBlock Text="{Binding GameName}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
						<TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding Downloads, Converter={StaticResource DlDisplay}}"/>
					</DockPanel>
					<TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0">
						<Run Text="by "/>
						<Run Text="{Binding UploaderName, Mode=OneWay}"/>
					</TextBlock>
				</StackPanel>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="DlTaskTpl">
			<Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
				<StackPanel>
					<DockPanel>
						<TextBlock Text="{Binding ModName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis"/>
						<Button Style="{StaticResource BaseButton}" FontSize="12" Padding="6,1" HorizontalAlignment="Right" Command="{Binding DataContext.CancelDlCmd, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVis}}">
							<TextBlock Text="&#x2715;" Foreground="#dc3545" FontSize="14"/>
						</Button>
						<Button Style="{StaticResource BaseButton}" FontSize="12" Padding="6,1" HorizontalAlignment="Right" Command="{Binding DataContext.DismissDlCmd, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Visibility="{Binding ShowDismiss, Converter={StaticResource BoolToVis}}">
							<TextBlock Text="&#x2715;" FontSize="14"/>
						</Button>
					</DockPanel>
					<ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,6,0,4" Style="{StaticResource DlProgress}"/>
					<TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
				</StackPanel>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="DepItemTpl">
			<DockPanel Margin="0,2">
				<Button DockPanel.Dock="Right" Margin="6,0,0,0" FontSize="11" Padding="8,4" Command="{Binding DataContext.OpenDetailCmd, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding ModId}">
					<TextBlock Text="{Binding DataContext.ModDlViewDep, Source={x:Static u:LanguageManager.Instance}}" Foreground="{DynamicResource AccentColor}"/>
					<Button.Style>
						<Style BasedOn="{StaticResource BaseButton}" TargetType="Button">
							<Style.Triggers>
								<DataTrigger Binding="{Binding ModId}" Value="0">
									<Setter Property="Visibility" Value="Collapsed"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
				<Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,6">
					<TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
				</Border>
			</DockPanel>
		</DataTemplate>
	</Page.Resources>

	<Grid FocusVisualStyle="{x:Null}">
		<!-- ═══ Login ═══ -->
		<Border x:Name="LoginPanel" Visibility="{Binding ShowLogin, Converter={StaticResource BoolToVis}}" FocusVisualStyle="{x:Null}">
			<ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
				<Border MaxWidth="380" VerticalAlignment="Center" Margin="40,20" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="28" BorderThickness="0">
					<StackPanel KeyDown="Login_KeyDown">
						<TextBlock x:Name="LoginTitle" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
						<TextBlock x:Name="LoginSub" Foreground="{DynamicResource TextSecondary}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,24"/>
						<TextBlock x:Name="LblLoginAcct" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
						<TextBox Text="{Binding LoginAccount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModInput}" Margin="0,0,0,14"/>
						<TextBlock x:Name="LblLoginPwd" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
						<PasswordBox x:Name="LoginPwdBox" Style="{StaticResource ModPwd}" Margin="0,0,0,20"/>
						<Button x:Name="BtnLogin" Style="{StaticResource AccentButton}" Click="Login_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
						<!-- ★ 忘记密码提示 -->
						<TextBlock x:Name="ForgotPwdHint" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,12"/>
						<TextBlock HorizontalAlignment="Center">
							<Run x:Name="RunNoAccount" Foreground="{DynamicResource TextSecondary}"/>
							<Hyperlink Foreground="{DynamicResource AccentColor}" Click="GoRegister_Click">
								<Run x:Name="RunGoReg"/>
							</Hyperlink>
						</TextBlock>
						<!-- ★ 登录页关于按钮 -->
						<Button x:Name="BtnLoginAbout" Style="{StaticResource BaseButton}" Click="AboutMod_Click" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="12"/>
						<TextBlock Foreground="#dc3545" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,16,0,0" Text="{Binding StatusMessage}"/>
					</StackPanel>
				</Border>
			</ScrollViewer>
		</Border>

		<!-- ═══ Register ═══ -->
		<Border x:Name="RegisterPanel" Visibility="{Binding ShowRegister, Converter={StaticResource BoolToVis}}" FocusVisualStyle="{x:Null}">
			<ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
				<Border MaxWidth="380" VerticalAlignment="Center" Margin="40,20" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="28" BorderThickness="0">
					<StackPanel KeyDown="Reg_KeyDown">
						<TextBlock x:Name="RegTitle" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
						<TextBlock x:Name="LblRegEmail" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
						<Grid Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBox Grid.Column="0" Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModInput}"/>
							<Button x:Name="BtnSendCode" Grid.Column="1" Style="{StaticResource BaseButton}" Content="{Binding CodeButtonText}" Command="{Binding SendCodeCmd}" IsEnabled="{Binding CodeButtonEnabled}" Margin="8,0,0,0" FontSize="12"/>
						</Grid>
						<TextBlock x:Name="LblRegCode" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
						<TextBox Text="{Binding RegCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModInput}" Margin="0,0,0,14" MaxLength="6"/>
						<TextBlock x:Name="LblRegUser" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
						<TextBox Text="{Binding RegUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModInput}" Margin="0,0,0,14"/>
						<TextBlock x:Name="LblRegPwd" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
						<PasswordBox x:Name="RegPwdBox" Style="{StaticResource ModPwd}" Margin="0,0,0,20"/>
						<Button x:Name="BtnRegister" Style="{StaticResource AccentButton}" Click="Reg_Click" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>
						<TextBlock HorizontalAlignment="Center">
							<Run x:Name="RunHasAcct" Foreground="{DynamicResource TextSecondary}"/>
							<Hyperlink Foreground="{DynamicResource AccentColor}" Click="GoLogin_Click">
								<Run x:Name="RunGoLogin"/>
							</Hyperlink>
						</TextBlock>
						<TextBlock Foreground="#dc3545" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,16,0,0" Text="{Binding StatusMessage}"/>
					</StackPanel>
				</Border>
			</ScrollViewer>
		</Border>

		<!-- ═══ Browse ═══ -->
		<Border x:Name="BrowsePanel" Visibility="{Binding ShowBrowse, Converter={StaticResource BoolToVis}}" FocusVisualStyle="{x:Null}">
			<Grid Margin="20,12">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<DockPanel Grid.Row="0" Margin="0,0,0,12">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<Button x:Name="BtnAboutMod" Style="{StaticResource BaseButton}" FontSize="12" Click="AboutMod_Click"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
						<TextBlock Text="{Binding StatsText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
						<TextBlock Text="{Binding CurrentUser}" Foreground="{DynamicResource AccentColor}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
						<Button x:Name="BtnLogout" Style="{StaticResource BaseButton}" Command="{Binding LogoutCmd}" FontSize="12"/>
					</StackPanel>
				</DockPanel>

				<Grid Grid.Row="1" Margin="0,0,0,12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
						<Button x:Name="CatAll" Style="{StaticResource BaseButton}" FontSize="12" Padding="12,6" Command="{Binding SetCategoryCmd}" CommandParameter="all" Margin="0,0,6,0"/>
						<Button x:Name="CatMod" Style="{StaticResource BaseButton}" FontSize="12" Padding="12,6" Command="{Binding SetCategoryCmd}" CommandParameter="mod" Margin="0,0,6,0"/>
						<Button x:Name="CatTool" Style="{StaticResource BaseButton}" FontSize="12" Padding="12,6" Command="{Binding SetCategoryCmd}" CommandParameter="tool" Margin="0,0,6,0"/>
						<Button x:Name="CatOther" Style="{StaticResource BaseButton}" FontSize="12" Padding="12,6" Command="{Binding SetCategoryCmd}" CommandParameter="other"/>
					</StackPanel>
					<Grid Grid.Column="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="200"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<!-- ★ 搜索框样式 = 密码输入框样式 -->
						<TextBox x:Name="SearchBox" Grid.Column="0" FontSize="12" Padding="10,6" Style="{StaticResource ModInput}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" KeyDown="Search_KeyDown"/>
						<Button x:Name="BtnSearch" Grid.Column="1" Style="{StaticResource AccentButton}" FontSize="12" Command="{Binding SearchCmd}" Margin="6,0,0,0" Padding="14,6"/>
					</Grid>
				</Grid>

				<Grid Grid.Row="2">
					<Border x:Name="LoadingOverlay" Panel.ZIndex="10" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Background="#99000000" CornerRadius="12" Margin="40,60" Padding="40,30" HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock x:Name="LoadingText" Foreground="#f0ece4" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
					</Border>
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding Mods}" ItemTemplate="{StaticResource ModCardTpl}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
					</ScrollViewer>
				</Grid>

				<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
					<Button x:Name="BtnPrev" Style="{StaticResource BaseButton}" FontSize="12" Padding="12,6" Command="{Binding PrevPageCmd}" IsEnabled="{Binding CanPrev}" Margin="0,0,8,0"/>
					<TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0">
						<Run Text="{Binding CurrentPage, Mode=OneWay}"/>
						<Run Text=" / "/>
						<Run Text="{Binding TotalPages, Mode=OneWay}"/>
					</TextBlock>
					<Button x:Name="BtnNext" Style="{StaticResource BaseButton}" FontSize="12" Padding="12,6" Command="{Binding NextPageCmd}" IsEnabled="{Binding CanNext}"/>
				</StackPanel>

				<Grid Grid.Row="4" Margin="0,12,0,0" Visibility="{Binding HasDownloads, Converter={StaticResource BoolToVis}}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<DockPanel Grid.Row="0" Margin="0,0,0,8">
						<Button x:Name="BtnClearDl" Style="{StaticResource BaseButton}" FontSize="11" Padding="10,4" DockPanel.Dock="Right" Command="{Binding ClearAllDlCmd}"/>
						<TextBlock x:Name="LblActiveDl" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="14" VerticalAlignment="Center"/>
					</DockPanel>
					<ScrollViewer Grid.Row="1" MaxHeight="200" VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding Downloads}" ItemTemplate="{StaticResource DlTaskTpl}"/>
					</ScrollViewer>
				</Grid>
			</Grid>
		</Border>

		<!-- ═══ Detail ═══ -->
		<Border x:Name="DetailOverlay" Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10" Background="#99000000" MouseDown="DetailOverlay_MouseDown">
			<Border x:Name="DetailCard" MaxWidth="660" MaxHeight="600" Background="{DynamicResource CardBackground}" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" MouseDown="DetailCard_MouseDown">
				<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
					<StackPanel DataContext="{Binding DetailMod}">
						<DockPanel>
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
								<TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="8,4,0,0" VerticalAlignment="Center">
									<Run Text=" v"/>
									<Run Text="{Binding Version, Mode=OneWay}"/>
								</TextBlock>
								<Border Background="{DynamicResource AccentColor}" CornerRadius="4" Padding="8,3" Margin="12,4,0,0" VerticalAlignment="Center">
									<TextBlock Text="{Binding Category, Converter={StaticResource CatDisplay}}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
								</Border>
							</StackPanel>
							<Button x:Name="BtnCloseDetail" Style="{StaticResource BaseButton}" Content="&#x2715;" FontSize="16" Padding="6,2" HorizontalAlignment="Right" Click="CloseDetail_Click"/>
						</DockPanel>
						<UniformGrid Columns="3" Margin="0,16,0,0">
							<StackPanel Margin="0,0,8,8">
								<TextBlock x:Name="DtlGame" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
								<TextBlock Text="{Binding GameName}" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
							</StackPanel>
							<StackPanel Margin="0,0,8,8">
								<TextBlock x:Name="DtlLang" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
								<TextBlock Text="{Binding Language}" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
							</StackPanel>
							<StackPanel Margin="0,0,8,8">
								<TextBlock x:Name="DtlAuthor" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
								<TextBlock Text="{Binding Author}" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
							</StackPanel>
							<StackPanel Margin="0,0,8,8">
								<TextBlock x:Name="DtlUploader" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
								<TextBlock Text="{Binding UploaderName}" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
							</StackPanel>
							<StackPanel Margin="0,0,8,8">
								<TextBlock x:Name="DtlDate" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
								<TextBlock Text="{Binding CreatedAt}" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
							</StackPanel>
							<StackPanel Margin="0,0,8,8">
								<TextBlock x:Name="DtlDl" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
								<TextBlock Text="{Binding Downloads, Converter={StaticResource DlDisplay}}" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
							</StackPanel>
						</UniformGrid>
						<ItemsControl ItemsSource="{Binding DetailImages}" Margin="0,12,0,0" Visibility="{Binding DetailImages.Count, Converter={StaticResource CountToVis}}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border CornerRadius="8" Margin="0,0,8,8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" ClipToBounds="True">
										<Image Source="{Binding}" Width="150" Height="90" Stretch="UniformToFill"/>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<TextBlock x:Name="DtlDescLabel" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" Margin="0,12,0,4"/>
						<TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextPrimary}" FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
						<TextBlock x:Name="DtlInstLabel" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" Margin="0,12,0,4" Visibility="{Binding Instructions, Converter={StaticResource NullToVis}}"/>
						<TextBlock Text="{Binding Instructions}" Foreground="{DynamicResource TextPrimary}" FontSize="13" TextWrapping="Wrap" LineHeight="22" Visibility="{Binding Instructions, Converter={StaticResource NullToVis}}"/>
						<TextBlock x:Name="DtlDepLabel" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" Margin="0,12,0,4" Visibility="{Binding Dependencies.Count, Converter={StaticResource CountToVis}}"/>
						<ItemsControl ItemsSource="{Binding Dependencies}" Visibility="{Binding Dependencies.Count, Converter={StaticResource CountToVis}}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<DockPanel Margin="0,2">
										<Button DockPanel.Dock="Right" Margin="6,0,0,0" FontSize="11" Padding="8,4" Command="{Binding DataContext.OpenDetailCmd, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding ModId}">
											<TextBlock Text="{Binding DataContext.ModDlViewDep, Source={x:Static u:LanguageManager.Instance}}" Foreground="{DynamicResource AccentColor}"/>
											<Button.Style>
												<Style BasedOn="{StaticResource BaseButton}" TargetType="Button">
													<Style.Triggers>
														<DataTrigger Binding="{Binding ModId}" Value="0">
															<Setter Property="Visibility" Value="Collapsed"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Button.Style>
										</Button>
										<Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,6">
											<TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
										</Border>
									</DockPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<StackPanel Orientation="Horizontal" Margin="0,16,0,0">
							<Button x:Name="BtnDlMod" Style="{StaticResource AccentButton}" Command="{Binding DataContext.DownloadCmd, RelativeSource={RelativeSource AncestorType=Page}}"/>
							<Button x:Name="BtnDlDirect" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Padding="16,8" Command="{Binding DataContext.DownloadDirectCmd, RelativeSource={RelativeSource AncestorType=Page}}"/>
						</StackPanel>
						<StackPanel DataContext="{Binding DataContext.ActiveDetailDownload, RelativeSource={RelativeSource AncestorType=Page}}" Visibility="{Binding DataContext.HasDetailDownload, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
							<ProgressBar Value="{Binding Progress}" Maximum="100" Style="{StaticResource DlProgress}" Margin="0,0,0,6"/>
							<TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</Border>
		</Border>

		<!-- ═══ About ═══ -->
		<Border x:Name="AboutOverlay" Visibility="{Binding ShowAbout, Converter={StaticResource BoolToVis}}" Panel.ZIndex="11" Background="#99000000" MouseDown="AboutOverlay_MouseDown">
			<Border x:Name="AboutCard" MaxWidth="520" Background="{DynamicResource CardBackground}" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" Padding="28" MouseDown="AboutCard_MouseDown">
				<StackPanel>
					<TextBlock x:Name="AboutTitle" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>
					<TextBlock x:Name="AboutText" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondary}" LineHeight="24" Margin="0,0,0,24"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<Button x:Name="BtnAboutOfficial" Style="{StaticResource BaseButton}" Click="AboutOfficial_Click" Margin="0,0,8,0"/>
						<Button x:Name="BtnAboutOK" Style="{StaticResource AccentButton}" Click="AboutOK_Click"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>
	</Grid>
</Page>