<Window x:Class="ETBTool.Windows.ProgressEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑进度" Width="400" Height="220" MinWidth="350" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource WindowBackground}"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackground}"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderColor}"
            CornerRadius="8">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_Drag" WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Button Content="&#x2715;" HorizontalAlignment="Right"
                        Width="36" Height="36" Background="Transparent"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderThickness="0" Cursor="Hand" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock Grid.Row="1" x:Name="SaveNameText" Style="{StaticResource MutedText}"
                       Margin="0,4,0,12"/>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="进度层级:" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0"/>
                <TextBox x:Name="ProgressInput" FontSize="14" Padding="8,6"
                         HorizontalContentAlignment="Center" MaxLength="6"/>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource BaseButton}"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="保存" Style="{StaticResource AccentButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>