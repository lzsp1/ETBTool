<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<SolidColorBrush x:Key="AccentColor"      Color="#5B8DEF"/>
	<SolidColorBrush x:Key="AccentHoverColor" Color="#7DA4F7"/>
	<SolidColorBrush x:Key="DangerColor"      Color="#EF5350"/>
	<SolidColorBrush x:Key="SuccessColor"     Color="#4CAF50"/>
	<SolidColorBrush x:Key="WarningColor"     Color="#FFC107"/>

	<!-- ★ 悬浮高亮：深浅模式各一套，ThemeManager 会动态切换 -->
	<Color x:Key="DarkHoverTintColor">#FFFFFF0D</Color>
	<Color x:Key="LightHoverTintColor">#0000000A</Color>
	<Color x:Key="HoverTintColor">#0000000A</Color>

	<!-- ★ 深色模式色值（带 Dark 前缀，ThemeManager 负责切换） -->
	<SolidColorBrush x:Key="DarkBackground"     Color="#121212"/>
	<SolidColorBrush x:Key="DarkSurface"        Color="#1E1E1E"/>
	<SolidColorBrush x:Key="DarkTextPrimary"    Color="#E8E8E8"/>
	<SolidColorBrush x:Key="DarkTextSecondary"  Color="#A0A0A0"/>
	<SolidColorBrush x:Key="DarkBorder"         Color="#333333"/>
	<SolidColorBrush x:Key="DarkButtonBg"       Color="#2A2A2A"/>
	<SolidColorBrush x:Key="DarkButtonHover"    Color="#383838"/>
	<SolidColorBrush x:Key="DarkCardBg"         Color="#1A1A1A"/>
	<SolidColorBrush x:Key="DarkCardHover"      Color="#252525"/>
	<SolidColorBrush x:Key="DarkSidebar"        Color="#0A0A0A"/>

	<!-- 浅色模式色值（带 Light 前缀） -->
	<SolidColorBrush x:Key="LightBackground"    Color="#FFFFFF"/>
	<SolidColorBrush x:Key="LightSurface"       Color="#F8F8F8"/>
	<SolidColorBrush x:Key="LightTextPrimary"   Color="#111111"/>
	<SolidColorBrush x:Key="LightTextSecondary" Color="#666666"/>
	<SolidColorBrush x:Key="LightBorder"        Color="#E0E0E0"/>
	<SolidColorBrush x:Key="LightButtonBg"      Color="#F2F2F2"/>
	<SolidColorBrush x:Key="LightButtonHover"   Color="#E8E8E8"/>
	<SolidColorBrush x:Key="LightCardBg"        Color="#FFFFFF"/>
	<SolidColorBrush x:Key="LightCardHover"     Color="#F5F5F5"/>
	<SolidColorBrush x:Key="LightSidebar"       Color="#FAFAFA"/>

	<!-- ★ 默认值改成浅色，避免加载前闪黑屏 -->
	<SolidColorBrush x:Key="WindowBackground"       Color="#FFFFFF"/>
	<SolidColorBrush x:Key="SurfaceColor"           Color="#F8F8F8"/>
	<SolidColorBrush x:Key="TextPrimary"            Color="#111111"/>
	<SolidColorBrush x:Key="TextSecondary"          Color="#666666"/>
	<SolidColorBrush x:Key="BorderColor"            Color="#E0E0E0"/>
	<SolidColorBrush x:Key="ButtonBackground"       Color="#F2F2F2"/>
	<SolidColorBrush x:Key="ButtonHoverBackground"  Color="#E8E8E8"/>
	<SolidColorBrush x:Key="CardBackground"         Color="#FFFFFF"/>
	<SolidColorBrush x:Key="CardHoverBackground"    Color="#F5F5F5"/>
	<SolidColorBrush x:Key="SidebarBackground"      Color="#FAFAFA"/>
</ResourceDictionary>